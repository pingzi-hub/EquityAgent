# Tushare
TUSHARE_TOKEN=your_tushare_token
# 可选：自定义 dataapi 网关（不填则使用 tushare_client 默认网关）
TUSHARE_DATAAPI_URL=http://your-tushare-gateway:port

# Azure OpenAI / OpenAI 兼容 API
AZURE_OPENAI_ENDPOINT=https://your-endpoint.example.com
AZURE_OPENAI_API_KEY=your_api_key
# 部署名须与网关/门户一致，例如 gpt-5.4、gpt-4o
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-12-01-preview
